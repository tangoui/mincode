{
  "description": "Data-only editor framework matching and completion metadata. No plugin code is executed.",
  "entry": {
    "type": "object",
    "required": ["id", "languages", "match", "completions"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9+#._-]{0,31}$"},
      "languages": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+#._-]{0,31}$"}},
      "match": {
        "type": "object",
        "required": ["all", "any", "exclude"],
        "properties": {
          "all": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/condition"}},
          "any": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/condition"}},
          "exclude": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/condition"}}
        },
        "additionalProperties": false
      },
      "completions": {
        "type": "array", "maxItems": 1000,
        "items": {
          "type": "object", "required": ["label", "insertText", "context", "detail", "documentation"],
          "properties": {
            "label": {"type": "string", "minLength": 1, "maxLength": 128},
            "insertText": {"type": "string", "minLength": 1, "maxLength": 1024},
            "context": {"type": "string", "minLength": 1, "maxLength": 128},
            "detail": {"type": "string", "maxLength": 1024},
            "documentation": {"type": "string", "maxLength": 4096}
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "condition": {
      "type": "object", "required": ["file"],
      "properties": {
        "file": {"type": "string", "minLength": 1, "maxLength": 128},
        "field": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "equals": {"type": "string", "maxLength": 128}
      },
      "additionalProperties": false
    }
  }
}

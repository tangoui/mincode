{
  "$comment": "Entry schema for contributes.keymaps. Strings of the form {{spec.path}} are replaced with values from contribution-points.json by tools/plugin-devkit/generate-schema.mjs. The host (backend/plugin/keymaps.go) is authoritative.",
  "description": "Keymap presets (declarative runtime only): inline presets or {\"path\"} references to JSON files inside the package.",
  "entry": {
    "type": "object",
    "required": ["id", "title", "rules"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "description": "<pluginId>.<name>"
      },
      "title": { "$ref": "#/$defs/keymapText" },
      "description": { "$ref": "#/$defs/keymapDescription" },
      "extends": {
        "type": "string",
        "description": "\"mincode\" or another preset of the same plugin"
      },
      "editorMode": { "enum": ["vim"] },
      "doubleModifier": { "type": "boolean" },
      "rules": {
        "type": "array",
        "maxItems": "{{limits.maxRules}}",
        "items": {
          "type": "object",
          "required": ["command"],
          "properties": {
            "key": { "type": "string", "maxLength": "{{limits.keyMaxLength}}" },
            "command": {
              "type": "string",
              "maxLength": "{{limits.commandMaxLength}}",
              "pattern": "^-?(builtin|workbench|editor|terminal|project|ai|database|plugin):[A-Za-z0-9][A-Za-z0-9._:\\-]*$"
            },
            "when": { "type": "string", "maxLength": "{{limits.whenMaxLength}}" },
            "platform": {
              "oneOf": [
                { "enum": ["mac", "win", "linux"] },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["mac", "win", "linux"] } }
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "keymapText": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" },
        "en": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" }
      },
      "additionalProperties": false
    },
    "keymapDescription": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": "{{limits.descriptionMaxRunes}}" },
        "en": { "type": "string", "minLength": 1, "maxLength": "{{limits.descriptionMaxRunes}}" }
      },
      "additionalProperties": false
    }
  }
}

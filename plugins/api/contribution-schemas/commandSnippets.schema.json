{
  "$comment": "Entry schema for contributes.commandSnippets (manifest apiVersion 2): a library of terminal commands, inline or a {\"path\"} reference to a JSON file under commands/ or assets/. Host validation lives in backend/plugin/contrib_command_snippets.go: command text may contain tabs and newlines but no carriage return, escape, other control, bidirectional override or zero-width character; every {{identifier}} placeholder must be a declared variable (other {{...}} text such as {{.Names}} stays literal); at most {{limits.commandsPerPlugin}} commands per plugin. Snippets are only inserted into the terminal prompt and never executed: trailing newlines are stripped, and multi-line text is inserted only in bracketed-paste mode after the paste confirmation.",
  "description": "Terminal command snippets: libraries of commands the user can insert (never run) from a terminal pane.",
  "entry": {
    "type": "object",
    "required": ["id", "title", "commands"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
      "title": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" },
      "titleLocalized": {
        "type": "object",
        "maxProperties": "{{limits.localesMax}}",
        "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" }
      },
      "targets": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": "{{lists.targets}}" },
        "description": "Terminal kinds the library is offered in; defaults to all."
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": "{{lists.platforms}}" },
        "description": "Local operating systems the library is offered on (local terminals only); defaults to all."
      },
      "commands": {
        "type": "array",
        "minItems": 1,
        "maxItems": "{{limits.commandsPerLibrary}}",
        "items": {
          "type": "object",
          "required": ["id", "title", "command"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
            "title": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" },
            "titleLocalized": {
              "type": "object",
              "maxProperties": "{{limits.localesMax}}",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.titleMaxRunes}}" }
            },
            "description": { "type": "string", "maxLength": "{{limits.descriptionMaxRunes}}" },
            "descriptionLocalized": {
              "type": "object",
              "maxProperties": "{{limits.localesMax}}",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.descriptionMaxRunes}}" }
            },
            "command": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "maxItems": "{{limits.commandMaxLines}}", "items": { "type": "string" } }
              ],
              "description": "Command text, or a list of lines joined with newlines; at most {{limits.commandMaxBytes}} bytes and {{limits.commandMaxLines}} lines."
            },
            "variables": {
              "type": "array",
              "maxItems": "{{limits.variablesMax}}",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$" },
                  "title": { "type": "string", "maxLength": "{{limits.variableTitleMaxRunes}}" },
                  "default": { "type": "string", "maxLength": "{{limits.variableDefaultMaxRunes}}" },
                  "quote": {
                    "enum": "{{lists.quoteModes}}",
                    "description": "\"posix\" single-quotes the user's value when it contains shell metacharacters; defaults to \"none\"."
                  }
                },
                "additionalProperties": false
              }
            },
            "tags": {
              "type": "array",
              "maxItems": "{{limits.tagsMax}}",
              "items": { "type": "string", "minLength": 1, "maxLength": "{{limits.tagMaxRunes}}" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}

{
  "$comment": "Entry schema for contributes.themes (declarative and process plugins). The host (backend/plugin/contrib_themes.go) additionally requires every tokens.required key, rejects keys outside tokens.required/optional, monacoColors and terminalKeys (all from contribution-points.json), and enforces contrast floors: text/surface >= 4.5, text-muted/surface >= 3, text-on-accent/accent >= 3, danger/surface >= 3. Themes cannot set fonts.",
  "description": "Color themes: inline themes or {\"path\"} references to JSON files inside the package.",
  "entry": {
    "type": "object",
    "required": ["id", "title", "kind", "colors"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "description": "<pluginId>.<name>" },
      "title": { "type": "string", "minLength": 1, "maxLength": 200 },
      "titleLocalized": { "type": "object", "additionalProperties": { "type": "string" } },
      "kind": { "enum": ["light", "dark"] },
      "colors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/themeColor" } },
      "editor": {
        "type": "object",
        "properties": {
          "colors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/themeColor" } },
          "rules": {
            "type": "array",
            "maxItems": "{{limits.tokenRulesMax}}",
            "items": {
              "type": "object",
              "required": ["token"],
              "properties": {
                "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]{0,128}$" },
                "foreground": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
                "background": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
                "fontStyle": { "type": "string", "pattern": "^\\s*(?:(?:italic|bold|underline|strikethrough)(?:\\s+|$))*$", "description": "Space-separated subset of italic, bold, underline, strikethrough; empty resets." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "terminal": { "type": "object", "additionalProperties": { "$ref": "#/$defs/themeColor" } }
    },
    "additionalProperties": false
  },
  "$defs": {
    "themeColor": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
  }
}

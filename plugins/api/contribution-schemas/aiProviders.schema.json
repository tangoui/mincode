{
  "$comment": "Entry schema for contributes.aiProviders (declarative and process plugins, manifest apiVersion 2). An entry is inline or a {\"path\"} reference to a JSON file under providers/ or assets/. Host validation lives in backend/plugin/contrib_ai_providers.go: baseUrl, signupUrl and docsUrl are https without userinfo; baseUrl has no query or fragment and its {name} placeholders (at most {{limits.placeholdersMax}}) are exactly the declared placeholders and sit only in the path; model is one of models; tier \"limited\" needs a caveat; maxInputTokens and maxOutputTokens are at most contextWindow.",
  "description": "AI provider presets offered in Settings > AI > Connection next to the built-in presets. The user types the API key in the host; the plugin never receives it.",
  "entry": {
    "type": "object",
    "required": ["id", "label", "baseUrl", "apiFormat", "model", "models", "contextWindow", "maxInputTokens", "maxOutputTokens", "tier", "region", "verifiedAt", "signupUrl"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\.[a-z0-9][a-z0-9-]{0,31}$", "description": "<pluginId>.<name>; a saved profile records this id as its source." },
      "label": { "type": "string", "minLength": 1, "maxLength": "{{limits.labelMaxRunes}}" },
      "labelLocalized": {
        "type": "object",
        "maxProperties": "{{limits.localesMax}}",
        "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.labelMaxRunes}}" }
      },
      "baseUrl": { "type": "string", "pattern": "^https://", "maxLength": "{{limits.urlMaxLength}}", "description": "May contain {name} placeholders in the path, e.g. https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1." },
      "placeholders": {
        "type": "array",
        "maxItems": "{{limits.placeholdersMax}}",
        "items": {
          "type": "object",
          "required": ["name", "label"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z_]{1,24}$" },
            "label": { "type": "string", "minLength": 1, "maxLength": "{{limits.labelMaxRunes}}" },
            "labelLocalized": {
              "type": "object",
              "maxProperties": "{{limits.localesMax}}",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.labelMaxRunes}}" }
            }
          },
          "additionalProperties": false
        }
      },
      "apiFormat": { "enum": "{{lists.apiFormats}}" },
      "anthropicAuth": { "enum": "{{lists.anthropicAuth}}", "description": "Only with apiFormat anthropic." },
      "model": { "type": "string", "minLength": 1, "maxLength": "{{limits.modelIdMaxLength}}", "description": "Default model; one of models." },
      "models": {
        "type": "array",
        "minItems": 1,
        "maxItems": "{{limits.modelsMax}}",
        "items": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": "{{limits.modelIdMaxLength}}", "pattern": "^[A-Za-z0-9@][A-Za-z0-9._:/@+-]*$" },
            "free": { "type": "boolean" },
            "tools": { "type": "boolean", "description": "false when the model cannot take tool definitions; the host then sends plain chat requests. Omitted means true." },
            "note": { "type": "string", "maxLength": "{{limits.noteMaxRunes}}" },
            "noteLocalized": {
              "type": "object",
              "maxProperties": "{{limits.localesMax}}",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.noteMaxRunes}}" }
            }
          },
          "additionalProperties": false
        }
      },
      "contextWindow": { "type": "integer", "minimum": 1, "maximum": "{{limits.contextWindowMax}}" },
      "maxInputTokens": { "type": "integer", "minimum": 1 },
      "maxOutputTokens": { "type": "integer", "minimum": 1 },
      "tier": { "enum": "{{lists.tiers}}" },
      "region": { "enum": "{{lists.regions}}", "description": "cn: reachable from mainland China; global: needs a proxy there; unknown: not tested." },
      "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date the listing was checked against the provider's official pages." },
      "quotaNote": { "type": "string", "maxLength": "{{limits.noteMaxRunes}}" },
      "quotaNoteLocalized": {
        "type": "object",
        "maxProperties": "{{limits.localesMax}}",
        "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.noteMaxRunes}}" }
      },
      "caveat": { "type": "string", "maxLength": "{{limits.noteMaxRunes}}", "description": "Required for tier limited." },
      "caveatLocalized": {
        "type": "object",
        "maxProperties": "{{limits.localesMax}}",
        "additionalProperties": { "type": "string", "minLength": 1, "maxLength": "{{limits.noteMaxRunes}}" }
      },
      "signupUrl": { "type": "string", "pattern": "^https://", "maxLength": "{{limits.urlMaxLength}}" },
      "docsUrl": { "type": "string", "pattern": "^https://", "maxLength": "{{limits.urlMaxLength}}" }
    },
    "additionalProperties": false
  }
}

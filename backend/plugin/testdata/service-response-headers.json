{
  "comment": "Response header vectors shared by the host (service_surface_context_test.go TestSurfaceContextSharedHeaderVectors) and the frontend (vue-app/scripts/services-contributions.test.mjs redactResponseHeaders): design ruling 19 / 19a. A value {\"repeat\": s, \"count\": n} is s repeated n times. frontendOnly cases use the request's secrets or the credential-shape patterns, which only the frontend applies.",
  "cases": [
    {
      "name": "sensitive names, fragments and oversized values",
      "headers": [
        ["Content-Type", "application/json"],
        ["Set-Cookie", "sid=abc"],
        ["set-cookie2", "sid=abc"],
        ["Authorization", "Bearer abc"],
        ["X-Session-Id", "s-1"],
        ["WWW-Authenticate", "Basic realm=x"],
        ["X-Csrf-Token", "t"],
        ["Proxy-Authorization", "Basic x"],
        ["Cookie", "a=b"],
        ["X-Large", { "repeat": "v", "count": 513 }],
        ["X-Edge", { "repeat": "v", "count": 512 }],
        ["ETag", "\"1\""]
      ],
      "kept": [
        ["Content-Type", "application/json"],
        ["X-Edge", { "repeat": "v", "count": 512 }],
        ["ETag", "\"1\""]
      ],
      "redacted": 9,
      "truncated": false
    },
    {
      "name": "URL-valued headers lose query and fragment",
      "headers": [
        ["Location", "https://app.example/callback?code=oauth-code-123&state=s#frag"],

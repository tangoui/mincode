{
  "name": "@mincode/vue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5150",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit --incremental false",
    "test:tool-selection": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test scripts/tool-selection.test.mjs scripts/mcp-tool-loading.test.mjs",
    "preview": "vite preview",
    "build:analyze": "ANALYZE=true pnpm run build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "test:components": "vue-tsc -p tsconfig.vitest.json --noEmit --incremental false && node scripts/vitest.mjs run",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:components && pnpm run build && pnpm run check:bundle",
    "test:command-palette": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test scripts/command-palette.test.mjs scripts/command-shortcuts.test.mjs scripts/command-when.test.mjs",
    "test:workspace-state-scope": "node scripts/workspace-state-scope.test.mjs",
    "test:http-resources": "node --experimental-strip-types --test scripts/http-resources.test.mjs",
    "test:database-table-search": "node --experimental-strip-types --test scripts/database-table-search.test.mjs scripts/database-charset-change.test.mjs",
    "test:workbench-session": "node --experimental-strip-types --test scripts/workbench-session.test.mjs",
    "test:plugin-ui": "node --experimental-strip-types --test scripts/plugin-ui-session.test.mjs scripts/plugin-ui-tasks.test.mjs scripts/plugin-view-warm-pool.test.mjs scripts/plugin-ui-fast-open.test.mjs scripts/plugin-sandbox-forms.test.mjs",
    "test:sftp-panel": "node --test scripts/sftp-panel-layout.test.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "3.4.13",
    "element-plus": "^2.14.3",
    "marked": "16.4.2",
    "monaco-editor": "^0.56.0",
    "monaco-vim": "0.4.4",
    "papaparse": "^5.5.4",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.6.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.14.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
